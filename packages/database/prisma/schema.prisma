generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl  = env("DATABASE_DIRECT_URL")
}

model Organisation {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(255)
  legalName   String?   @db.VarChar(255)
  abn         String?   @db.VarChar(20)
  status      TenantStatus @default(pending)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  practices   Practice[]
  users       User[]
  invitations Invitation[]

  @@map("organisations")
  @@index([name])
}

model Practice {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  organisationId String    @db.Uuid
  name           String    @db.VarChar(255)
  status         TenantStatus @default(pending)
  createdAt      DateTime  @default(now()) @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @db.Timestamptz()

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  locations      Location[]
  users          User[]

  @@map("practices")
  @@index([tenantId, organisationId])
}

model Location {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  practiceId     String    @db.Uuid
  name           String    @db.VarChar(255)
  address        String?
  phone          String?
  timezone       String    @default("Australia/Adelaide") @db.VarChar(64)
  status         TenantStatus @default(pending)
  createdAt      DateTime  @default(now()) @db.Timestamptz()
  updatedAt      DateTime  @updatedAt @db.Timestamptz()

  practice       Practice  @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  users          User[]

  @@map("locations")
  @@index([tenantId, practiceId])
}

model User {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  organisationId String?      @db.Uuid
  practiceId    String?       @db.Uuid
  locationId    String?       @db.Uuid
  email         String        @unique @db.VarChar(255)
  passwordHash  String        @db.VarChar(255)
  firstName     String        @db.VarChar(100)
  lastName      String        @db.VarChar(100)
  phone         String?       @db.VarChar(32)
  role          UserRole      @default(receptionist)
  status        UserStatus    @default(pending)
  lastLoginAt   DateTime?     @db.Timestamptz()
  createdAt     DateTime      @default(now()) @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @db.Timestamptz()

  organisation  Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  practice      Practice?     @relation(fields: [practiceId], references: [id], onDelete: SetNull)
  location      Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sessions      UserSession[]
  mfaFactors    MFAFactor[]
  apiKeys       ApiKey[]
  auditLogs     AuditLog[]
  roleAssignments RoleAssignment[]
  passwordResetTokens PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@map("users")
  @@index([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, status])
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshToken String    @unique @db.VarChar(512)
  userAgent    String?   @db.VarChar(255)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime  @db.Timestamptz()
  revokedAt    DateTime? @db.Timestamptz()
  createdAt    DateTime  @default(now()) @db.Timestamptz()

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sessions")
  @@index([userId])
  @@index([refreshToken])
}

model LoginAttempt {
  email         String    @id @db.VarChar(255)
  attempts      Int       @default(0)
  lockedUntil    DateTime? @db.Timestamptz()
  lastAttemptAt DateTime  @default(now()) @db.Timestamptz()
  createdAt     DateTime  @default(now()) @db.Timestamptz()

  @@map("login_attempts")
  @@index([lockedUntil])
  @@index([lastAttemptAt])
}

model MFAFactor {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  type       MFAType   @default(totp)
  secret     String    @db.VarChar(255)
  verified   Boolean   @default(false)
  backupCodes Json?
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_factors")
}

enum Environment {
  DEV
  STAGING
  PROD
}

model ApiKey {
  id               String     @id @default(uuid()) @db.Uuid
  tenantId         String     @db.Uuid
  userId           String     @db.Uuid
  name             String     @db.VarChar(255)
  env              Environment @default(PROD)
  version          Int        @default(1)
  keyHash          String     @db.VarChar(255)
  keyPrefix        String     @db.VarChar(16) @unique
  scopes           Json
  rateLimit        Json?
  ipAllowlist      Json?
  lastUsedAt       DateTime?  @db.Timestamptz()
  expiresAt        DateTime?  @db.Timestamptz()
  revokedAt        DateTime?  @db.Timestamptz()
  revokedBy        String?
  revocationReason String?
  graceExpiresAt   DateTime?  @db.Timestamptz()
  previousKeyId    String?    @db.Uuid
  createdAt        DateTime   @default(now()) @db.Timestamptz()
  updatedAt        DateTime   @updatedAt @db.Timestamptz()

  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  previousKey      ApiKey?    @relation("KeyRotation", fields: [previousKeyId], references: [id])
  nextKeys         ApiKey[]   @relation("KeyRotation")

  @@map("api_keys")
  @@index([tenantId])
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(255)
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@map("roles")
  @@index([tenantId])
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  resource    String    @db.VarChar(100)
  action      String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @db.Timestamptz()

  roles       RolePermission[]

  @@unique([resource, action], map: "unique_resource_action")
  @@map("permissions")
  @@index([resource, action])
}

model RoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "unique_user_role")
  @@map("user_roles")
  @@index([userId])
  @@index([roleId])
}

model RolePermission {
  id           String    @id @default(uuid()) @db.Uuid
  roleId       String    @db.Uuid
  permissionId String    @db.Uuid
  createdAt    DateTime  @default(now()) @db.Timestamptz()

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "unique_role_permission")
  @@map("role_permissions")
  @@index([roleId])
  @@index([permissionId])
}

model Invitation {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  email       String       @db.VarChar(255)
  role        UserRole     @default(receptionist)
  token       String       @unique @db.VarChar(255)
  expiresAt   DateTime     @db.Timestamptz()
  acceptedAt  DateTime?    @db.Timestamptz()
  createdAt   DateTime     @default(now()) @db.Timestamptz()

  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("invitations")
  @@index([token])
  @@index([email])
}

model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  userId       String?   @db.Uuid
  action       String    @db.VarChar(100)
  resourceType String?   @db.VarChar(100)
  resourceId   String?   @db.Uuid
  ipAddress    String?   @db.VarChar(64)
  userAgent    String?   @db.VarChar(255)
  correlationId String?  @db.VarChar(64)
  result       String    @default("success") @db.VarChar(20)
  metadata     Json?
  createdAt    DateTime  @default(now()) @db.Timestamptz()

  user         User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String    @unique @db.VarChar(255)
  expiresAt  DateTime  @db.Timestamptz()
  usedAt     DateTime? @db.Timestamptz()
  createdAt  DateTime  @default(now()) @db.Timestamptz()

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
  @@index([token])
  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  token      String    @unique @db.VarChar(255)
  expiresAt  DateTime  @db.Timestamptz()
  usedAt     DateTime? @db.Timestamptz()
  createdAt  DateTime  @default(now()) @db.Timestamptz()

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
  @@index([token])
  @@index([userId])
}

model TenantSetting {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  key        String    @db.VarChar(100)
  value      Json
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  @@unique([tenantId, key], map: "unique_tenant_setting")
  @@map("tenant_settings")
  @@index([tenantId])
}

model Patient {
  id                       String    @id @default(uuid()) @db.Uuid
  tenantId                 String    @db.Uuid
  patientNumber            String    @db.VarChar(50)
  firstName                String    @db.VarChar(100)
  lastName                 String    @db.VarChar(100)
  preferredName            String?   @db.VarChar(100)
  dateOfBirth              DateTime  @db.Timestamptz()
  gender                   String?   @db.VarChar(20)
  email                    String?   @db.VarChar(255)
  phone                    String?   @db.VarChar(32)
  medicareNumber           String?   @db.VarChar(20)
  healthFundName           String?   @db.VarChar(100)
  healthFundNumber         String?   @db.VarChar(50)
  healthFundMembershipNumber String?  @db.VarChar(50)
  passwordHash             String?   @db.VarChar(255)
  status                   PatientStatus @default(active)
  createdAt                DateTime  @default(now()) @db.Timestamptz()
  updatedAt                DateTime  @updatedAt @db.Timestamptz()

  addresses      PatientAddress[]
  contacts       PatientContact[]
  medicalHistory PatientMedicalHistory[]
  allergies      PatientAllergy[]
  medications    PatientMedication[]
  alerts         PatientAlert[]
  consents       PatientConsent[]
  documents      PatientDocument[]
  appointments   Appointment[]
  clinicalNotes  ClinicalNote[]
  dentalCharts   DentalChart[]
  treatmentHistory TreatmentHistory[]
  treatmentPlans TreatmentPlan[]
  periodontalRecords PeriodontalRecord[]
  imagingStudies ImagingStudy[]
  forms PatientForm[]

  @@unique([tenantId, patientNumber], map: "unique_tenant_patient_number")
  @@map("patients")
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, dateOfBirth])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
}

model PatientForm {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  patientId   String    @db.Uuid
  type        String    @db.VarChar(100)
  status      String    @default("pending") @db.VarChar(50)
  data        Json?
  submittedAt DateTime? @db.Timestamptz()
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_forms")
  @@index([tenantId, patientId])
}

model PatientAddress {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  street     String    @db.VarChar(255)
  suburb     String    @db.VarChar(100)
  state      String    @db.VarChar(50)
  postcode   String    @db.VarChar(10)
  country    String    @default("Australia") @db.VarChar(50)
  isPrimary  Boolean   @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_addresses")
  @@index([tenantId, patientId])
}

model PatientContact {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  type       PatientContactType @default(other)
  firstName  String?   @db.VarChar(100)
  lastName   String?   @db.VarChar(100)
  phone      String?   @db.VarChar(32)
  email      String?   @db.VarChar(255)
  relationship String? @db.VarChar(100)
  isEmergency Boolean  @default(false)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_contacts")
  @@index([tenantId, patientId])
}

model PatientMedicalHistory {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  condition  String    @db.VarChar(255)
  notes      String?   @db.VarChar(1000)
  diagnosedAt DateTime? @db.Timestamptz()
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medical_history")
  @@index([tenantId, patientId])
}

model PatientAllergy {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  allergen   String    @db.VarChar(255)
  severity   AllergySeverity @default(moderate)
  reaction   String?   @db.VarChar(1000)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_allergies")
  @@index([tenantId, patientId])
}

model PatientMedication {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  name       String    @db.VarChar(255)
  dosage     String?   @db.VarChar(100)
  frequency  String?   @db.VarChar(100)
  prescribedBy String? @db.VarChar(255)
  startDate  DateTime? @db.Timestamptz()
  endDate    DateTime? @db.Timestamptz()
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medications")
  @@index([tenantId, patientId])
}

model PatientAlert {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  type       AlertType @default(medical)
  severity   AlertSeverity @default(warning)
  message    String    @db.VarChar(500)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_alerts")
  @@index([tenantId, patientId])
}

model PatientConsent {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  type       ConsentType @default(treatment)
  grantedAt  DateTime  @default(now()) @db.Timestamptz()
  expiresAt  DateTime? @db.Timestamptz()
  grantedBy  String?   @db.VarChar(255)
  notes      String?   @db.VarChar(1000)
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_consents")
  @@index([tenantId, patientId])
}

model PatientDocument {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  patientId  String    @db.Uuid
  name       String    @db.VarChar(255)
  mimeType   String    @db.VarChar(100)
  size       Int
  storageKey String    @db.VarChar(500)
  uploadedBy String?   @db.VarChar(255)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  patient    Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_documents")
  @@index([tenantId, patientId])
}

enum TenantStatus {
  pending
  active
  suspended
  deactivated
}

enum UserRole {
  platform_owner
  platform_admin
  organisation_owner
  practice_manager
  dentist
  specialist
  hygienist
  dental_therapist
  dental_assistant
  receptionist
  billing_officer
  finance
  read_only
}

enum UserStatus {
  pending
  active
  suspended
  deactivated
}

enum MFAType {
  totp
  sms
  email
}

enum PatientStatus {
  active
  inactive
  deceased
}

enum PatientContactType {
  emergency
  gp
  referrer
  guardian
  other
}

enum AllergySeverity {
  mild
  moderate
  severe
}

enum AlertType {
  medical
  dental
  administrative
}

enum AlertSeverity {
  info
  warning
  critical
}

enum ConsentType {
  treatment
  privacy
  marketing
  research
}

enum AppointmentStatus {
  scheduled
  confirmed
  checked_in
  in_progress
  completed
  cancelled
  no_show
}

model AppointmentType {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(500)
  duration    Int
  color       String?   @db.VarChar(7)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  appointments Appointment[]

  @@map("appointment_types")
  @@index([tenantId])
}

model Provider {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  userId      String    @db.Uuid
  firstName   String    @db.VarChar(100)
  lastName    String    @db.VarChar(100)
  email       String?   @db.VarChar(255)
  phone       String?   @db.VarChar(32)
  color       String?   @db.VarChar(7)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  availabilities Availability[]
  appointments   Appointment[]
  clinicalNotes  ClinicalNote[]
  treatmentHistory TreatmentHistory[]
  treatmentPlans TreatmentPlan[]
  periodontalRecords PeriodontalRecord[]
  imagingStudies ImagingStudy[]

  @@map("providers")
  @@index([tenantId])
}

model Chair {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  locationId  String?   @db.Uuid
  name        String    @db.VarChar(255)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  appointments Appointment[]

  @@map("chairs")
  @@index([tenantId])
}

model Availability {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @db.Uuid
  providerId String    @db.Uuid
  dayOfWeek  Int
  startTime  String    @db.VarChar(8)
  endTime    String    @db.VarChar(8)
  createdAt  DateTime  @default(now()) @db.Timestamptz()
  updatedAt  DateTime  @updatedAt @db.Timestamptz()

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("availability")
  @@index([tenantId, providerId])
}

model Appointment {
  id                String          @id @default(uuid()) @db.Uuid
  tenantId          String          @db.Uuid
  patientId         String          @db.Uuid
  providerId        String          @db.Uuid
  chairId           String          @db.Uuid
  appointmentTypeId String          @db.Uuid
  startTime         DateTime        @db.Timestamptz()
  endTime           DateTime        @db.Timestamptz()
  status            AppointmentStatus @default(scheduled)
  notes             String?         @db.VarChar(1000)
  createdAt         DateTime        @default(now()) @db.Timestamptz()
  updatedAt         DateTime        @updatedAt @db.Timestamptz()

  patient         Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider        Provider        @relation(fields: [providerId], references: [id], onDelete: Restrict)
  chair           Chair           @relation(fields: [chairId], references: [id], onDelete: Restrict)
  appointmentType AppointmentType @relation(fields: [appointmentTypeId], references: [id], onDelete: Restrict)
  imagingStudies  ImagingStudy[]

  @@map("appointments")
  @@index([tenantId, patientId])
  @@index([tenantId, providerId])
  @@index([tenantId, startTime, endTime])
  @@index([tenantId, startTime, status])
}

model ClinicalNote {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  patientId   String    @db.Uuid
  appointmentId String? @db.Uuid
  providerId  String    @db.Uuid
  note        String    @db.VarChar(5000)
  type        ClinicalNoteType @default(general)
  signedAt    DateTime? @db.Timestamptz()
  signedBy    String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider  Provider  @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@map("clinical_notes")
  @@index([tenantId, patientId])
  @@index([tenantId, appointmentId])
}

model Template {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(255)
  category    String    @db.VarChar(100)
