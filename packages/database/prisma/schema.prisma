  subject     String?   @db.VarChar(255)
  body        String    @db.VarChar(5000)
  variables   Json?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  @@map("communication_templates")
  @@index([tenantId])
  @@index([tenantId, category])
}

model CommunicationPreference {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  patientId        String    @db.Uuid
  smsEnabled       Boolean   @default(true)
  emailEnabled     Boolean   @default(true)
  inAppEnabled     Boolean   @default(true)
  patientPortalEnabled Boolean @default(true)
  marketingConsent Boolean   @default(false)
  reminderChannel  MessageChannel @default(sms)
  reminderLeadTime Int       @default(24)
  createdAt        DateTime  @default(now()) @db.Timestamptz()
  updatedAt        DateTime  @updatedAt @db.Timestamptz()

  @@unique([tenantId, patientId], map: "unique_tenant_patient_comm_pref")
  @@map("communication_preferences")
  @@index([tenantId, patientId])
}

model Notification {
  id          String          @id @default(uuid()) @db.Uuid
  tenantId    String          @db.Uuid
  patientId   String?         @db.Uuid
  userId      String?         @db.Uuid
  type        NotificationType
  title       String          @db.VarChar(255)
  message     String          @db.VarChar(1000)
  data        Json?
  readAt      DateTime?       @db.Timestamptz()
  createdAt   DateTime        @default(now()) @db.Timestamptz()

  @@map("notifications")
  @@index([tenantId, patientId])
  @@index([tenantId, userId])
  @@index([tenantId, type])
}

model Message {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @db.Uuid
  patientId   String?       @db.Uuid
  channel     MessageChannel
  status      MessageStatus @default(pending)
  subject     String?       @db.VarChar(255)
  body        String        @db.VarChar(5000)
  recipient   String        @db.VarChar(255)
  provider    String?       @db.VarChar(100)
  externalId  String?       @db.VarChar(255)
  error       String?       @db.VarChar(1000)
  sentAt      DateTime?     @db.Timestamptz()
  deliveredAt DateTime?     @db.Timestamptz()
  readAt      DateTime?     @db.Timestamptz()
  createdAt   DateTime      @default(now()) @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @db.Timestamptz()

  @@map("messages")
  @@index([tenantId, patientId])
  @@index([tenantId, channel])
  @@index([tenantId, status])
}

model Recall {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @db.Uuid
  patientId     String        @db.Uuid
  type          RecallType
  status        RecallStatus  @default(due)
  dueDate       DateTime      @db.Timestamptz()
  notes         String?       @db.VarChar(1000)
  contactCount  Int           @default(0)
  lastContactAt DateTime?     @db.Timestamptz()
  bookedAt      DateTime?     @db.Timestamptz()
  completedAt   DateTime?     @db.Timestamptz()
  createdAt     DateTime      @default(now()) @db.Timestamptz()
  updatedAt     DateTime      @updatedAt @db.Timestamptz()

  @@map("recalls")
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, dueDate])
}

model AppointmentReminder {
  id            String          @id @default(uuid()) @db.Uuid
  tenantId      String          @db.Uuid
  appointmentId String          @db.Uuid
  channel       MessageChannel
  status        ReminderStatus   @default(scheduled)
  scheduledAt   DateTime         @db.Timestamptz()
  sentAt        DateTime?        @db.Timestamptz()
  deliveredAt   DateTime?        @db.Timestamptz()
  error         String?          @db.VarChar(1000)
  createdAt     DateTime         @default(now()) @db.Timestamptz()
  updatedAt     DateTime         @updatedAt @db.Timestamptz()

  @@map("appointment_reminders")
  @@index([tenantId, appointmentId])
  @@index([tenantId, status])
}
