model Service {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(500)
  category    String?   @db.VarChar(100)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  feeSchedules FeeSchedule[]
  invoiceItems InvoiceItem[]

  @@map("services")
  @@index([tenantId])
}

model FeeSchedule {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  serviceId   String    @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  currency    String    @default("AUD") @db.VarChar(3)
  effectiveFrom DateTime @default(now()) @db.Timestamptz()
  effectiveTo   DateTime? @db.Timestamptz()
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("fee_schedules")
  @@index([tenantId, serviceId])
  @@index([tenantId, effectiveFrom, effectiveTo])
}

model Invoice {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  patientId   String      @db.Uuid
  invoiceNumber String    @db.VarChar(50)
  status      InvoiceStatus @default(draft)
  issueDate   DateTime    @default(now()) @db.Timestamptz()
  dueDate     DateTime    @db.Timestamptz()
  subtotal    Decimal     @db.Decimal(12, 2)
  tax         Decimal     @default(0) @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  balance     Decimal     @db.Decimal(12, 2)
  notes       String?     @db.VarChar(1000)
  voidedAt    DateTime?   @db.Timestamptz()
  voidedBy    String?     @db.VarChar(255)
  createdAt   DateTime    @default(now()) @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @db.Timestamptz()

  items InvoiceItem[]
  payments PaymentAllocation[]
  refunds Refund[]
  creditNotes CreditNote[]

  @@unique([tenantId, invoiceNumber], map: "unique_tenant_invoice_number")
  @@map("invoices")
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, status, issueDate])
  @@index([tenantId, issueDate])
}

model InvoiceItem {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  invoiceId   String    @db.Uuid
  serviceId   String?   @db.Uuid
  description String    @db.VarChar(255)
  quantity    Int       @default(1)
  unitPrice   Decimal   @db.Decimal(10, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  total       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@map("invoice_items")
  @@index([tenantId, invoiceId])
}

model Payment {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @db.Uuid
  patientId     String      @db.Uuid
  method        PaymentMethod
  amount        Decimal     @db.Decimal(12, 2)
  currency      String      @default("AUD") @db.VarChar(3)
  status        PaymentStatus @default(pending)
  reference     String?     @db.VarChar(255)
  providerTxId  String?     @db.VarChar(255)
  idempotencyKey String?   @unique @db.VarChar(255)
  receivedAt    DateTime    @default(now()) @db.Timestamptz()
  createdAt     DateTime    @default(now()) @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @db.Timestamptz()

  allocations PaymentAllocation[]

  @@map("payments")
  @@index([tenantId, patientId])
  @@index([tenantId, status])
  @@index([tenantId, status, receivedAt])
  @@index([providerTxId])
}

model PaymentAllocation {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  paymentId   String    @db.Uuid
  invoiceId   String    @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, paymentId, invoiceId], map: "unique_payment_invoice")
  @@map("payment_allocations")
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
}

model Refund {
  id          String      @id @default(uuid()) @db.Uuid
  tenantId    String      @db.Uuid
  paymentId   String      @db.Uuid
  invoiceId   String?     @db.Uuid
  amount      Decimal     @db.Decimal(12, 2)
  reason      String?     @db.VarChar(500)
  status      RefundStatus @default(pending)
  processedAt DateTime?   @db.Timestamptz()
  createdAt   DateTime    @default(now()) @db.Timestamptz()
  updatedAt   DateTime    @updatedAt @db.Timestamptz()

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@map("refunds")
  @@index([tenantId, paymentId])
  @@index([tenantId, invoiceId])
}

model CreditNote {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  invoiceId   String    @db.Uuid
  amount      Decimal   @db.Decimal(12, 2)
  reason      String?   @db.VarChar(500)
  appliedAt   DateTime  @default(now()) @db.Timestamptz()
  createdAt   DateTime  @default(now()) @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @db.Timestamptz()

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("credit_notes")
  @@index([tenantId, invoiceId])
}

enum MessageChannel {
  sms
  email
  in_app
  patient_portal
}

enum MessageStatus {
  pending
  sent
  delivered
  failed
  read
}

enum NotificationType {
  appointment
  recall
  billing
  clinical
  system
}

enum RecallType {
  examination
  hygiene
  periodontal
  xray
  treatment_followup
  custom
}

enum RecallStatus {
  due
  overdue
  booked
  completed
  failed
  cancelled
}

enum ReminderStatus {
  scheduled
  sent
  delivered
  failed
  cancelled
}

model CommunicationTemplate {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  name        String    @db.VarChar(255)
