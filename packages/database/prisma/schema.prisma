generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model Organisation {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(255)
  legalName   String?      @db.VarChar(255)
  abn         String?      @db.VarChar(20)
  status      TenantStatus @default(pending)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  invitations Invitation[]
  practices   Practice[]
  users       User[]

  @@index([name])
  @@map("organisations")
}

model Practice {
  id                    String       @id @default(uuid()) @db.Uuid
  tenantId              String       @db.Uuid
  organisationId        String       @db.Uuid
  name                  String       @db.VarChar(255)
  status                TenantStatus @default(pending)
  createdAt             DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(6)
  dailyProductionTarget Decimal?     @db.Decimal(12, 2)
  locations             Location[]
  organisation          Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  users                 User[]

  @@index([tenantId, organisationId])
  @@map("practices")
}

model Location {
  id         String       @id @default(uuid()) @db.Uuid
  tenantId   String       @db.Uuid
  practiceId String       @db.Uuid
  name       String       @db.VarChar(255)
  address    String?
  phone      String?
  timezone   String       @default("Australia/Adelaide") @db.VarChar(64)
  status     TenantStatus @default(pending)
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(6)
  practice   Practice     @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  users      User[]

  @@index([tenantId, practiceId])
  @@map("locations")
}

model User {
  id                                                        String                   @id @default(uuid()) @db.Uuid
  tenantId                                                  String                   @db.Uuid
  organisationId                                            String?                  @db.Uuid
  practiceId                                                String?                  @db.Uuid
  locationId                                                String?                  @db.Uuid
  email                                                     String                   @unique @db.VarChar(255)
  passwordHash                                              String                   @db.VarChar(255)
  firstName                                                 String                   @db.VarChar(100)
  lastName                                                  String                   @db.VarChar(100)
  phone                                                     String?                  @db.VarChar(32)
  role                                                      UserRole                 @default(receptionist)
  status                                                    UserStatus               @default(pending)
  lastLoginAt                                               DateTime?                @db.Timestamptz(6)
  createdAt                                                 DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                                                 DateTime                 @updatedAt @db.Timestamptz(6)
  Estimate                                                  Estimate[]
  apiKeys                                                   ApiKey[]
  auditLogs                                                 AuditLog[]
  emailVerificationTokens                                   EmailVerificationToken[]
  estimate_approvals                                        estimate_approvals[]
  mfaFactors                                                MFAFactor[]
  passwordResetTokens                                       PasswordResetToken[]
  tooth_conditions_tooth_conditions_createdByUserIdTousers  ToothCondition[]         @relation("tooth_conditions_createdByUserIdTousers")
  tooth_conditions_tooth_conditions_resolvedByUserIdTousers ToothCondition[]         @relation("tooth_conditions_resolvedByUserIdTousers")
  roleAssignments                                           RoleAssignment[]
  sessions                                                  UserSession[]
  location                                                  Location?                @relation(fields: [locationId], references: [id])
  organisation                                              Organisation?            @relation(fields: [organisationId], references: [id])
  practice                                                  Practice?                @relation(fields: [practiceId], references: [id])

  @@index([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, status])
  @@map("users")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  refreshToken String    @unique
  userAgent    String?   @db.VarChar(255)
  ipAddress    String?   @db.VarChar(64)
  expiresAt    DateTime  @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

model LoginAttempt {
  email         String    @id @db.VarChar(255)
  attempts      Int       @default(0)
  lockedUntil   DateTime? @db.Timestamptz(6)
  lastAttemptAt DateTime  @default(now()) @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([lockedUntil])
  @@index([lastAttemptAt])
  @@map("login_attempts")
}

model MFAFactor {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  type        MFAType  @default(totp)
  secret      String   @db.VarChar(255)
  verified    Boolean  @default(false)
  backupCodes Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("mfa_factors")
}

model ApiKey {
  id               String      @id @default(uuid()) @db.Uuid
  tenantId         String      @db.Uuid
  userId           String      @db.Uuid
  name             String      @db.VarChar(255)
  keyHash          String      @db.VarChar(255)
  keyPrefix        String      @unique @db.VarChar(16)
  scopes           Json
  lastUsedAt       DateTime?   @db.Timestamptz(6)
  expiresAt        DateTime?   @db.Timestamptz(6)
  revokedAt        DateTime?   @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  version          Int         @default(1)
  env              Environment @default(PROD)
  rateLimit        Json?
  updatedAt        DateTime    @updatedAt @db.Timestamptz(6)
  revokedBy        String?
  revocationReason String?
  graceExpiresAt   DateTime?   @db.Timestamptz(6)
  previousKeyId    String?     @db.Uuid
  ipAllowlist      Json?
  previousKey      ApiKey?     @relation("KeyRotation", fields: [previousKeyId], references: [id])
  nextKeys         ApiKey[]    @relation("KeyRotation")
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  name        String           @db.VarChar(255)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(6)
  permissions RolePermission[]
  assignments RoleAssignment[]

  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  resource    String           @db.VarChar(100)
  action      String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @db.Timestamptz(6)
  roles       RolePermission[]

  @@unique([resource, action], map: "unique_resource_action")
  @@index([resource, action])
  @@map("permissions")
}

model RoleAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "unique_user_role")
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "unique_role_permission")
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Invitation {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  email        String       @db.VarChar(255)
  role         UserRole     @default(receptionist)
  token        String       @unique @db.VarChar(255)
  digest       String       @db.VarChar(64)
  expiresAt    DateTime     @db.Timestamptz(6)
  acceptedAt   DateTime?    @db.Timestamptz(6)
  createdAt    DateTime     @default(now()) @db.Timestamptz(6)
  organisation Organisation @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([digest])
  @@index([email])
  @@map("invitations")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String?  @db.Uuid
  userId        String?  @db.Uuid
  action        String   @db.VarChar(100)
  resourceType  String?  @db.VarChar(100)
  resourceId    String?  @db.Uuid
  ipAddress     String?  @db.VarChar(64)
  userAgent     String?  @db.VarChar(255)
  correlationId String?  @db.VarChar(64)
  result        String   @default("success") @db.VarChar(20)
  metadata      Json?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  user          User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.VarChar(255)
  digest    String    @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([digest])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  token     String    @unique @db.VarChar(255)
  digest    String    @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([digest])
  @@index([userId])
  @@map("email_verification_tokens")
}

model TenantSetting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String   @db.VarChar(100)
  value     Json
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([tenantId, key], map: "unique_tenant_setting")
  @@index([tenantId])
  @@map("tenant_settings")
}

model Patient {
  id                                                                     String                     @id @default(uuid()) @db.Uuid
  tenantId                                                               String                     @db.Uuid
  patientNumber                                                          String                     @db.VarChar(50)
  firstName                                                              String                     @db.VarChar(100)
  lastName                                                               String                     @db.VarChar(100)
  preferredName                                                          String?                    @db.VarChar(100)
  dateOfBirth                                                            DateTime                   @db.Timestamptz(6)
  gender                                                                 String?                    @db.VarChar(20)
  email                                                                  String?                    @db.VarChar(255)
  phone                                                                  String?                    @db.VarChar(32)
  medicareNumber                                                         String?                    @db.VarChar(20)
  healthFundName                                                         String?                    @db.VarChar(100)
  healthFundNumber                                                       String?                    @db.VarChar(50)
  healthFundMembershipNumber                                             String?                    @db.VarChar(50)
  status                                                                 PatientStatus              @default(active)
  createdAt                                                              DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt                                                              DateTime                   @updatedAt @db.Timestamptz(6)
  passwordHash                                                           String?                    @db.VarChar(255)
  billingAddress                                                         Json?
  billingEmail                                                           String?                    @db.VarChar(255)
  billingName                                                            String?                    @db.VarChar(200)
  billingTaxId                                                           String?                    @db.VarChar(50)
  doNotContact                                                           Boolean                    @default(false)
  nationalId                                                             String?                    @db.VarChar(50)
  nationalIdType                                                         String?                    @db.VarChar(20)
  notes                                                                  String?                    @db.VarChar(2000)
  photoUrl                                                               String?                    @db.VarChar(500)
  preferredLanguage                                                      String?                    @db.VarChar(10)
  profession                                                             String?                    @db.VarChar(100)
  workplace                                                              String?                    @db.VarChar(200)
  Estimate                                                               Estimate[]
  appointments                                                           Appointment[]
  clinicalNotes                                                          ClinicalNote[]
  dentalCharts                                                           DentalChart[]
  imagingStudies                                                         ImagingStudy[]
  insurance_claims                                                       insurance_claims[]
  invoices                                                               Invoice[]
  addresses                                                              PatientAddress[]
  alerts                                                                 PatientAlert[]
  allergies                                                              PatientAllergy[]
  consents                                                               PatientConsent[]
  contacts                                                               PatientContact[]
  documents                                                              PatientDocument[]
  forms                                                                  PatientForm[]
  patient_legal_guardians                                                patient_legal_guardians?
  patient_medical_context                                                patient_medical_context?
  medicalHistory                                                         PatientMedicalHistory[]
  medications                                                            PatientMedication[]
  patient_relationships_patient_relationships_patientIdTopatients        patient_relationships[]    @relation("patient_relationships_patientIdTopatients")
  patient_relationships_patient_relationships_relatedPatientIdTopatients patient_relationships[]    @relation("patient_relationships_relatedPatientIdTopatients")
  patient_surgical_history                                               patient_surgical_history[]
  payments                                                               Payment[]
  periodontalRecords                                                     PeriodontalRecord[]
  treatmentHistory                                                       TreatmentHistory[]
  treatmentPlans                                                         TreatmentPlan[]

  @@unique([tenantId, patientNumber], map: "unique_tenant_patient_number")
  @@index([tenantId, lastName, firstName])
  @@index([tenantId, dateOfBirth])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, createdAt])
  @@map("patients")
}

model PatientForm {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  patientId   String    @db.Uuid
  type        String    @db.VarChar(100)
  status      String    @default("pending") @db.VarChar(50)
  data        Json?
  submittedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(6)
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_forms")
}

model PatientAddress {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  patientId String   @db.Uuid
  street    String   @db.VarChar(255)
  suburb    String   @db.VarChar(100)
  state     String   @db.VarChar(50)
  postcode  String   @db.VarChar(10)
  country   String   @default("Australia") @db.VarChar(50)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_addresses")
}

model PatientContact {
  id              String             @id @default(uuid()) @db.Uuid
  tenantId        String             @db.Uuid
  patientId       String             @db.Uuid
  type            PatientContactType @default(other)
  firstName       String?            @db.VarChar(100)
  lastName        String?            @db.VarChar(100)
  phone           String?            @db.VarChar(32)
  email           String?            @db.VarChar(255)
  relationship    String?            @db.VarChar(100)
  isEmergency     Boolean            @default(false)
  createdAt       DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @db.Timestamptz(6)
  isLegalGuardian Boolean            @default(false)
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_contacts")
}

model PatientMedicalHistory {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  patientId    String    @db.Uuid
  condition    String    @db.VarChar(255)
  notes        String?   @db.VarChar(1000)
  diagnosedAt  DateTime? @db.Timestamptz(6)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  isControlled Boolean   @default(true)
  isCritical   Boolean   @default(false)
  medications  String?   @db.VarChar(500)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_medical_history")
}

model PatientAllergy {
  id        String          @id @default(uuid()) @db.Uuid
  tenantId  String          @db.Uuid
  patientId String          @db.Uuid
  allergen  String          @db.VarChar(255)
  severity  AllergySeverity @default(moderate)
  reaction  String?         @db.VarChar(1000)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)
  patient   Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_allergies")
}

model PatientMedication {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @db.Uuid
  patientId    String    @db.Uuid
  name         String    @db.VarChar(255)
  dosage       String?   @db.VarChar(100)
  frequency    String?   @db.VarChar(100)
  prescribedBy String?   @db.VarChar(255)
  startDate    DateTime? @db.Timestamptz(6)
  endDate      DateTime? @db.Timestamptz(6)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)
  patient      Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_medications")
}

model PatientAlert {
  id        String        @id @default(uuid()) @db.Uuid
  tenantId  String        @db.Uuid
  patientId String        @db.Uuid
  type      AlertType     @default(medical)
  severity  AlertSeverity @default(warning)
  message   String        @db.VarChar(500)
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_alerts")
}

model PatientConsent {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  patientId String      @db.Uuid
  type      ConsentType @default(treatment)
  grantedAt DateTime    @default(now()) @db.Timestamptz(6)
  expiresAt DateTime?   @db.Timestamptz(6)
  grantedBy String?     @db.VarChar(255)
  notes     String?     @db.VarChar(1000)
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_consents")
}

model PatientDocument {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  patientId  String   @db.Uuid
  name       String   @db.VarChar(255)
  mimeType   String   @db.VarChar(100)
  size       Int
  storageKey String   @db.VarChar(500)
  uploadedBy String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @db.Timestamptz(6)
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([tenantId, patientId])
  @@map("patient_documents")
}

model AppointmentType {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  name         String        @db.VarChar(255)
  description  String?       @db.VarChar(500)
  duration     Int
  color        String?       @db.VarChar(7)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  code         String?       @db.VarChar(32)
  appointments Appointment[]

  @@index([tenantId])
  @@map("appointment_types")
}

model Provider {
  id                   String                 @id @default(uuid()) @db.Uuid
  tenantId             String                 @db.Uuid
  userId               String                 @db.Uuid
  firstName            String                 @db.VarChar(100)
  lastName             String                 @db.VarChar(100)
  email                String?                @db.VarChar(255)
  phone                String?                @db.VarChar(32)
  color                String?                @db.VarChar(7)
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  Estimate             Estimate[]
  appointments         Appointment[]
  clinicalNotes        ClinicalNote[]
  imagingStudies       ImagingStudy[]
  periodontalRecords   PeriodontalRecord[]
  provider_shifts      provider_shifts[]
  schedule_overrides   schedule_overrides[]
  tooth_conditions     ToothCondition[]
  treatmentHistory     TreatmentHistory[]
  treatment_plan_items treatment_plan_items[]
  treatmentPlans       TreatmentPlan[]

  @@index([tenantId])
  @@map("providers")
}

model Chair {
  id           String        @id @default(uuid()) @db.Uuid
  tenantId     String        @db.Uuid
  locationId   String?       @db.Uuid
  name         String        @db.VarChar(255)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  description  String?       @db.VarChar(255)
  appointments Appointment[]

  @@index([tenantId])
  @@map("chairs")
}

model Appointment {
  id                        String                      @id @default(uuid()) @db.Uuid
  tenantId                  String                      @db.Uuid
  patientId                 String                      @db.Uuid
  providerId                String                      @db.Uuid
  chairId                   String                      @db.Uuid
  appointmentTypeId         String                      @db.Uuid
  startTime                 DateTime                    @db.Timestamptz(6)
  endTime                   DateTime                    @db.Timestamptz(6)
  status                    AppointmentStatus           @default(scheduled)
  notes                     String?                     @db.VarChar(1000)
  createdAt                 DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt                 DateTime                    @updatedAt @db.Timestamptz(6)
  scheduledPrice            Decimal?                    @db.Decimal(12, 2)
  appointment_status_events appointment_status_events[]
  appointment_treatments    appointment_treatments[]
  appointmentType           AppointmentType             @relation(fields: [appointmentTypeId], references: [id])
  chair                     Chair                       @relation(fields: [chairId], references: [id])
  patient                   Patient                     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  provider                  Provider                    @relation(fields: [providerId], references: [id])
  imagingStudies            ImagingStudy[]
  treatment_plan_items      treatment_plan_items[]

