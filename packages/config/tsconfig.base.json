{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "verbatimModuleSyntax": false,
    "baseUrl": ".",
    "paths": {
      "@danta/schemas": ["packages/schemas/src/index.ts"],
      "@danta/database": ["packages/database/src/index.ts"],
      "@danta/auth": ["packages/auth/src/index.ts"],
      "@danta/permissions": ["packages/permissions/src/index.ts"],
      "@danta/ui": ["packages/ui/src/index.ts"],
      "@danta/config": ["packages/config/src/index.ts"]
    }
  }
}
