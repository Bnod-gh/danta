{
  "name": "@danta/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --config nest-cli.json --path tsconfig.json --entryFile apps/gateway/src/main --builder tsc",
    "start": "node dist/main",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "test:unit": "jest --passWithNoTests",
    "test:integration": "jest --testPathPattern=integration --passWithNoTests"
  },
  "dependencies": {
    "@danta/config": "workspace:*",
    "@danta/contracts": "workspace:*",
    "@danta/schemas": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^8.0.0",
    "@nestjs/throttler": "^6.0.0",
    "nestjs-zod": "^4.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/axios": "^0.14.0",
    "@types/node": "^22.0.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.0"
  }
}
