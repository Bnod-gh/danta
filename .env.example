# === Danta Environment Variables ===

# Database
DATABASE_URL="postgresql://danta:danta@localhost:5432/danta?schema=public"
DATABASE_DIRECT_URL="postgresql://danta:danta@localhost:5432/danta"

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173

# Web
WEB_PORT=5173
WEB_URL=http://localhost:5173

# Auth
JWT_SECRET=change-me-in-production-use-a-strong-secret
JWT_REFRESH_SECRET=change-me-in-production-use-a-strong-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# MFA
MFA_ISSUER=Danta

# Storage (object storage - placeholder for local/S3/MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_ENDPOINT=

# Email/SMS (placeholders)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=
SMS_API_KEY=

# Integrations (placeholders - no production secrets in repo)
HICAPS_API_KEY=
HICAPS_MERCHANT_ID=
MEDICARE_API_KEY=
TYRO_API_KEY=
TYRO_MERCHANT_ID=

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Feature Flags
FEATURE_HICAPS=false
FEATURE_MEDICARE=false
FEATURE_PATIENT_PORTAL=false
FEATURE_IMAGING=true
