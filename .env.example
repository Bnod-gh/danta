# === Danta Environment Variables ===

# Database
DATABASE_URL=""
DATABASE_DIRECT_URL=""

# Redis
REDIS_URL="redis://localhost:6379"

# API
API_PORT=3001
API_URL=http://localhost:3001
IDENTITY_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:5173

# Web
WEB_PORT=5173
WEB_URL=http://localhost:5173
VITE_API_BASE_URL=/api/v1

# Auth
JWT_SECRET=change-me-in-production-use-a-strong-secret
JWT_REFRESH_SECRET=change-me-in-production-use-a-strong-secret
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d


# MFA
MFA_ISSUER=Danta

# Storage (object storage - MinIO local by default)
STORAGE_PROVIDER=minio
STORAGE_LOCAL_PATH=./storage
STORAGE_S3_BUCKET=danta-storage
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_PUBLIC_URL=http://localhost:9000

# Email/SMS (placeholders)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMS_PROVIDER=
SMS_API_KEY=

# Integrations (placeholders - no production secrets in repo)
HICAPS_API_KEY=
HICAPS_MERCHANT_ID=
MEDICARE_API_KEY=
TYRO_API_KEY=
TYRO_MERCHANT_ID=

# Observability
LOG_LEVEL=info
SENTRY_DSN=

# Feature Flags
FEATURE_HICAPS=false
FEATURE_MEDICARE=false
FEATURE_PATIENT_PORTAL=false
FEATURE_IMAGING=true
PRACTICE_PORT=3003

# SMS (Twilio) - falls back to console mock when unset
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Recall engine
RECALL_SCAN_CRON="15 * * * *"
RECALL_MAX_CONTACTS=3
RECALL_CONTACT_COOLDOWN_DAYS=6
# AI SOAP synthesis (OpenAI-compatible) - template composer used when unset
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
